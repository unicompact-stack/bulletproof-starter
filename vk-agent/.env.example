# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- Тематика ---
# Какая тематика активна. Список: npm run profiles
# banks      — банки, карты, вклады
# vacancies  — вакансии и подработка
# Флаг --profile в команде перекрывает эту переменную.
PROFILE=banks

# --- Площадки ---
# Что включено, решается в channels/channels.json, а не здесь.
# Здесь только ключи от площадок. Незаполненный ключ = площадка не готова к публикации.

# --- ВКонтакте ---
# ID сообщества (число из адреса, без минуса). Например адрес vk.com/club123456 -> 123456
VK_GROUP_ID=

# Ключ доступа сообщества.
# ВК: Управление -> Настройки -> Работа с API -> Создать ключ
# Права ключа: «Управление сообществом» + «Записи на стене» (если нужны фото — «Фотографии»)
VK_TOKEN=

# Версия API. Менять без нужды не надо.
VK_API_VERSION=5.199

# --- Telegram (площадка-заглушка, адаптера пока нет) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Дзен (площадка-заглушка, адаптера пока нет) ---
DZEN_TOKEN=
DZEN_CHANNEL_ID=

# --- Панель превью ---
# Порт панели. В песочнице Arena открой превью, на своём компьютере — http://localhost:4321
PORT=4321
# Слушать все интерфейсы (нужно для превью в песочнице)
HOST=0.0.0.0

# --- Поведение ---
# Сколько дней считать факт свежим. Старше — проверка выдаст предупреждение.
FACT_TTL_DAYS=30
# Таймаут загрузки страниц, мс
FETCH_TIMEOUT_MS=15000
