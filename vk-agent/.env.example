# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- ВКонтакте ---
# ID сообщества (число из адреса, без минуса). Например адрес vk.com/club123456 -> 123456
VK_GROUP_ID=

# Ключ доступа сообщества.
# ВК: Управление -> Настройки -> Работа с API -> Создать ключ
# Права ключа: «Управление сообществом» + «Записи на стене» (если нужны фото — «Фотографии»)
VK_TOKEN=

# Версия API. Менять без нужды не надо.
VK_API_VERSION=5.199

# --- Панель превью ---
# Порт панели. В песочнице Arena открой превью, на своём компьютере — http://localhost:4321
PORT=4321
# Слушать все интерфейсы (нужно для превью в песочнице)
HOST=0.0.0.0

# --- Поведение ---
# Сколько дней считать факт свежим. Старше — проверка выдаст предупреждение.
FACT_TTL_DAYS=30
# Таймаут загрузки страниц банков, мс
FETCH_TIMEOUT_MS=15000
