# Секреты
.env
.env.*
!.env.example

# Кэш загруженных страниц и журналы
data/cache/*
!data/cache/.gitkeep
data/*.jsonl

# Собранные факты: локальные данные конкретной машины, в git не едут.
# Остаётся только пример формата.
knowledge/facts/*.json
!knowledge/facts/_example.json

# Node
node_modules/

# Черновики и опубликованное не храним в git: это рабочая очередь, а не код.
# В ВК уже есть готовая история — дублировать её в git незачем.
queue/*.json
!queue/README.md
